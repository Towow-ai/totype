# Copy to config/local.env (git-ignored) and edit. Every line is optional;
# environment variables of the same name take precedence over this file.
# The defaults live in scripts/lib/env.sh.

# Bundle identifier of the built app. Pick one that is yours: macOS ties
# Accessibility / Input Monitoring grants and Keychain items to it.
VERBATIM_BUNDLE_ID="ai.towow.totype"

# Code-signing identity name (see `security find-identity -v -p codesigning`).
# Create a stable self-signed one with scripts/install_local_signing_identity.sh.
# If the identity does not exist the build falls back to ad-hoc signing and
# prints a warning: every rebuild then changes the code signature and macOS
# may revoke Microphone / Accessibility / Input Monitoring grants.
VERBATIM_SIGN_IDENTITY="Totype Local Code Signing"

# English display name, executable name and install path component.
VERBATIM_APP_NAME="Totype"
# Chinese display name (written to zh-Hans InfoPlist.strings). Empty by default: no localized name.
# VERBATIM_APP_NAME_ZH=""

# Folder under ~/Library/Application Support that holds the app's data (history,
# audio, lexicon, downloaded models). Written into Info.plist as
# VVDataDirectoryName; install.sh reads the handshake files from it.
# VERBATIM_DATA_DIR_NAME="Totype"

# Starting value of "观察插入后的人工修改" (learn from manual edits after insertion)
# for users who have never changed it. 0 = off, 1 = on (public default). A choice
# the user already made is kept.
# VERBATIM_LEARN_FROM_EDITS_DEFAULT=1

# 1 (default): pack the SenseVoice runtime and models (about 246 MB) into the app.
# 0: lite build without them; the app downloads and verifies them on first use.
# VERBATIM_BUNDLE_MODEL=1

# Pin a specific SDK instead of whatever `xcrun --sdk macosx --show-sdk-path`
# selects (must be macOS 15.4 or newer).
# VERBATIM_SDK_PATH="/Library/Developer/CommandLineTools/SDKs/MacOSX15.4.sdk"

# iOS scripts only (VerbatimVoiceMobile/scripts): SDK for the Catalyst type-check.
# export VERBATIM_MACOS_SDK="/Library/Developer/CommandLineTools/SDKs/MacOSX26.sdk"
